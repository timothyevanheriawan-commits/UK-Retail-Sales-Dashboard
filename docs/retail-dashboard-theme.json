{
  "name": "Retail Dashboard Theme",
  "dataColors": [
    "#1F4E5F",
    "#2E8B8B",
    "#5FA8A8",
    "#8FC1C1",
    "#B8D8D8",
    "#D9A441",
    "#C6604A",
    "#7A6C5D"
  ],
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#1F4E5F",
  "good": "#2E8B57",
  "neutral": "#D9A441",
  "bad": "#C6604A",
  "maximum": "#1F4E5F",
  "center": "#8FC1C1",
  "minimum": "#F2F2F2",
  "null": "#CCCCCC",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "color": "#1A1A1A"
    },
    "title": {
      "fontSize": 14,
      "color": "#1A1A1A",
      "fontFace": "Segoe UI Semibold"
    },
    "header": {
      "fontSize": 12,
      "color": "#1A1A1A"
    },
    "label": {
      "fontSize": 10,
      "color": "#404040"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E0E0E0" } },
            "radius": 4
          }
        ],
        "title": [
          {
            "fontSize": 13,
            "fontColor": { "solid": { "color": "#1A1A1A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F4E5F" } },
            "fontSize": 28
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#404040" } },
            "fontSize": 11
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FAFAFA" } }
          }
        ]
      }
    }
  }
}
